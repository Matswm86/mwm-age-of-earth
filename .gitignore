# Godot 4 generated cache and import files
.godot/
.import/
*.translation
*.import
# World 1 atlases: VRAM compression, mipmaps and size limits must reach CI
# (DESIGN 4b / 11, QA 2026-10-10 finding 5).
!assets/models/*/textures/*.png.import

# Mock sources that stay on disk only
docs/mockups/src/*.blend
docs/mockups/src/*_raw.png
docs/mockups/src/*.blend1

# Tool caches
.ruff_cache/
__pycache__/

# OS noise
.DS_Store
Thumbs.db

# Build artifacts
*.apk
*.aab
*.ipa
build/

# Godot Gradle source template (installed in CI from export templates)
android/build/
android/.build_version

# Local screenshots from the capture bot
screenshots/raw/

# Editor
.vscode/
.idea/
*.swp
docs/mockups/src/__pycache__/

# Raw asset downloads and Blender build files (2 GB, several files > 50 MB). Sources and licences stay tracked.
assets/_raw/**
!assets/_raw/**/
!assets/_raw/**/SOURCE.md
!assets/_raw/sketchfab/**/*.json
!assets/_raw/.gdignore

# Opening intro textures: VRAM compression, mipmaps and lossless data maps must reach CI
!assets/intro/*.import

# Game terrain and VAT bodies: Texture2DArray slices, lossless height, uncompressed VAT meshes
# (UV2 holds vertex ids) must reach CI
!assets/terrain/game/*.import
!assets/vat/*.glb.import

# Match textures (models, bodies, hero): VRAM compression (ETC2/ASTC on the phone), normal-map
# mode and the 2048 px limit must reach CI; CI's default import left them uncompressed (~1.1 GB of
# VRAM, phone pass 2026-10-11)
!assets/game_models/*.png.import
!assets/game_models/*.jpg.import
!assets/vat/*.png.import
!assets/vat/*.jpg.import
!assets/intro/hero/*.png.import
!assets/intro/hero/*.jpg.import
